{
  "seed": 42,
  "device": "auto",
  "num_workers": 4,
  "mixed_precision": "fp16",
  "command": "train",
  "output_dir": "auto",
  "data": {
    "root": "data/pannuke"
  },
  "model": {
    "backbone": {
      "input_size": 256,
      "patch_size": 8,
      "in_channels": 3,
      "dim": 768,
      "depth": 12,
      "num_heads": 12,
      "num_classes": null
    },
    "num_classes": 6,
    "decoder_dim": 256,
    "out_indices": [
      2,
      5,
      8,
      11
    ],
    "head": "decoder_v2"
  },
  "pretrained": "pretrained_checkpoints/dit.pth",
  "training": {
    "batch_size": 8,
    "eval_batch_size": 4,
    "epochs": 20,
    "backbone_lr": 1e-05,
    "lr": 0.0003,
    "weight_decay": 0.0001,
    "rate": 0.3
  },
  "splits": [
    [
      "fold1",
      "fold2",
      "fold3"
    ],
    [
      "fold2",
      "fold3",
      "fold1"
    ],
    [
      "fold3",
      "fold1",
      "fold2"
    ]
  ],
  "boundary_metrics": true
}
